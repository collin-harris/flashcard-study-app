# Copy this file to .env and replace the placeholder values with your own.
# Never commit .env to version control.

# Database
POSTGRES_USER=your_postgres_username
POSTGRES_DB=your_database_name
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@db:5432/your_database_name

# Authentication
# Signs login tokens. The backend refuses to start if this is missing, shorter
# than 32 characters, or still this placeholder. Generate a random one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a different key in each environment, and never reuse this example value.
SECRET_KEY=your_secret_key_here

# AI card generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI card generation limits (optional; these are the defaults). Each cap
# covers a rolling 24 hours. The demo account's cap replaces the per-user
# one, and every request also counts toward the global cap.
# GENERATION_LIMIT_PER_USER=5
# GENERATION_LIMIT_DEMO=20
# GENERATION_LIMIT_GLOBAL=100
# DEMO_ACCOUNT_EMAIL=demo@flashcardapp.com
